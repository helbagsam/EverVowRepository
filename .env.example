# Salin file ini jadi .env.local lalu isi nilainya.

# Connection string dari Neon dashboard (Settings > Connection string).
# Pastikan pakai yang "pooled connection" untuk Vercel.
DATABASE_URL=postgres://user:password@ep-xxxxx.neon.tech/dbname?sslmode=require

# String acak minimal 32 karakter untuk enkripsi cookie session PEMBELI.
# Generate lewat: openssl rand -base64 32
SESSION_SECRET=

# String acak LAIN (beda dari SESSION_SECRET) untuk cookie session ADMIN.
ADMIN_SESSION_SECRET=

# Password untuk masuk ke /admin (generator lisensi). Ganti dengan yang kuat,
# ini satu-satunya lapisan proteksi ke halaman generator kode kamu.
ADMIN_PASSWORD=

# Token dari UploadThing dashboard (uploadthing.com > API Keys).
UPLOADTHING_TOKEN=

# --- Automasi pembelian via Lynk.id (opsional, isi kalau dipakai) ---

# "Merchant Key" yang diberikan Lynk.id saat kamu pasang URL webhook di
# Settings > Integrations > Webhooks. Endpoint /api/webhook/lynkid MENOLAK
# semua request kalau ini kosong (fail-closed demi keamanan).
LYNKID_WEBHOOK_SECRET=

# API key dari resend.com (dashboard > API Keys). Dipakai untuk kirim email
# otomatis berisi kode lisensi setelah webhook Lynk.id diterima. Kalau
# kosong, lisensi tetap dibuat otomatis tapi email TIDAK terkirim (kamu
# harus kirim manual dari data di /admin, atau pembeli pakai /claim setelah
# kamu isi variabel ini).
RESEND_API_KEY=

# Alamat "From" untuk email kode lisensi, mis. "EverVow Lux <noreply@domainkamu.com>".
# Kalau domain kamu belum diverifikasi di Resend, boleh dikosongkan dulu —
# akan fallback ke alamat testing resend.dev (cuma bisa kirim ke email
# yang kamu daftarkan sendiri di akun Resend, jadi WAJIB diisi domain
# sendiri sebelum go-live ke pembeli asli).
NOTIFY_FROM_EMAIL=

# URL production kamu (tanpa trailing slash), dipakai untuk bikin link
# "/login" di email kode lisensi. Mis. https://evervowlux.vercel.app
NEXT_PUBLIC_APP_URL=
